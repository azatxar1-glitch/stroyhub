# Database
# Local dev default (schema provider = "sqlite"):
DATABASE_URL="file:./dev.db"
# Production (after switching schema provider to "postgresql"), use a Neon/Supabase/etc connection string:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js (NextAuth v5)
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# File uploads: leave unset locally (falls back to public/uploads on disk).
# On Vercel, enabling Blob storage for the project injects this automatically.
# BLOB_READ_WRITE_TOKEN=""

# Uncomment and fill in to enable OAuth providers later
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
